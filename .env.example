# Copy to .env. All APP_* variables are optional for local use (loopback only).

# --- Docker/Caddy deployment ---
# Domain Caddy obtains a TLS certificate for (DNS A/AAAA record must point at the host).
APP_DOMAIN=life.example.com
# Short git SHA reported by /healthz (optional): GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=

# --- App ---
# Public URL, origin only. Set at BUILD time too (Server Actions allowedOrigins). Enables HSTS + secure cookies for https.
APP_PUBLIC_ORIGIN=https://life.example.com
# Extra comma-separated hostnames accepted in the Host header (no scheme/port).
APP_ALLOWED_HOSTS=
# 1 only when a trusted reverse proxy overwrites X-Forwarded-*. Compose sets this itself.
APP_TRUST_PROXY=0
# >=16 chars. Required to claim a fresh install; if empty a one-time token is printed to the server log.
APP_SETUP_TOKEN=
# Lock a session after N idle minutes (default 30).
APP_IDLE_LOCK_MINUTES=30
# Hard session lifetime in hours (default 12).
APP_SESSION_MAX_HOURS=12
# Max simultaneously open vaults (LRU-evicted, default 50).
APP_MAX_OPEN_VAULTS=50
# 1 to show a profile picker on the login page (default 0).
APP_PROFILE_PICKER=0
# 1 to force Secure cookies even without an https APP_PUBLIC_ORIGIN (e.g. TLS-terminating tunnel).
APP_SECURE_COOKIES=0
# Data directory (container: /app/data; local default: data). Never point tests at the real vault.
# APP_DATA_DIR=data
